
services:
  db:
    image: postgres:15
    container_name: barber_db
    restart: always
    environment:
      POSTGRES_USER: proy2
      POSTGRES_PASSWORD: secret
      POSTGRES_DB: barberdb
    ports:
      - "5432:5432"
    volumes:
      - db_data:/var/lib/postgresql/data
      - ./db/init.sql:/docker-entrypoint-initdb.d/init.sql

  backend:
    build: ./backend
    container_name: barber_backend
    restart: always
    depends_on:
      - db
    environment:
      DB_HOST: db
      DB_PORT: 5432
      DB_USER: proy2
      DB_PASSWORD: secret
      DB_NAME: barberdb
    ports:
      - "3000:3000"

  frontend:
    build: ./frontend
    container_name: barber_frontend
    restart: always
    depends_on:
      - backend
    ports:
      - "5173:5173"

volumes:
  db_data: