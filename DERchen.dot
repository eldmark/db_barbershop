digraph BarberiaER {
    rankdir=LR;
    node [fontname="Helvetica"];

    // ENTIDADES
    Cliente [shape=box];
    Empleado [shape=box];
    Servicio [shape=box];
    Producto [shape=box];
    Categoria [shape=box];
    Proveedor [shape=box];
    Venta [shape=box];
    DetalleVentaProducto [shape=box];
    DetalleVentaServicio [shape=box];
    Reserva [shape=box];

    // RELACIONES
    Realiza [shape=diamond, label="realiza"];
    AtiendeVenta [shape=diamond, label="atiende"];
    IncluyeProducto [shape=diamond, label="incluye_producto"];
    IncluyeServicio [shape=diamond, label="incluye_servicio"];
    Pertenece [shape=diamond, label="pertenece"];
    Suministra [shape=diamond, label="suministra"];
    Agenda [shape=diamond, label="agenda"];
    AtiendeReserva [shape=diamond, label="atiende"];
    ReservadoEn [shape=diamond, label="reservado_en"];
    Genera [shape=diamond, label="genera"];

    // ATRIBUTOS CLIENTE
    c_id [shape=ellipse, label="id_cliente"];
    c_nombre [shape=ellipse, label="nombre"];
    c_tel [shape=ellipse, label="telefono"];
    c_email [shape=ellipse, label="email"];

    Cliente -> c_id;
    Cliente -> c_nombre;
    Cliente -> c_tel;
    Cliente -> c_email;

    // ATRIBUTOS EMPLEADO
    e_id [shape=ellipse, label="id_empleado"];
    e_nombre [shape=ellipse, label="nombre"];
    e_especialidad [shape=ellipse, label="especialidad"];
    e_salario [shape=ellipse, label="salario"];

    Empleado -> e_id;
    Empleado -> e_nombre;
    Empleado -> e_especialidad;
    Empleado -> e_salario;

    // ATRIBUTOS SERVICIO
    s_id [shape=ellipse, label="id_servicio"];
    s_nombre [shape=ellipse, label="nombre"];
    s_precio [shape=ellipse, label="precio"];

    Servicio -> s_id;
    Servicio -> s_nombre;
    Servicio -> s_precio;

    // ATRIBUTOS PRODUCTO
    p_id [shape=ellipse, label="id_producto"];
    p_nombre [shape=ellipse, label="nombre"];
    p_precio [shape=ellipse, label="precio"];
    p_stock [shape=ellipse, label="stock"];

    Producto -> p_id;
    Producto -> p_nombre;
    Producto -> p_precio;
    Producto -> p_stock;

    // ATRIBUTOS CATEGORIA
    cat_id [shape=ellipse, label="id_categoria"];
    cat_nombre [shape=ellipse, label="nombre"];

    Categoria -> cat_id;
    Categoria -> cat_nombre;

    // ATRIBUTOS PROVEEDOR
    prov_id [shape=ellipse, label="id_proveedor"];
    prov_nombre [shape=ellipse, label="nombre"];
    prov_contacto [shape=ellipse, label="contacto"];

    Proveedor -> prov_id;
    Proveedor -> prov_nombre;
    Proveedor -> prov_contacto;

    // ATRIBUTOS VENTA
    v_id [shape=ellipse, label="id_venta"];
    v_fecha [shape=ellipse, label="fecha"];
    v_total [shape=ellipse, label="total"];

    Venta -> v_id;
    Venta -> v_fecha;
    Venta -> v_total;

    // ATRIBUTOS DETALLE VENTA PRODUCTO
    dpp_id [shape=ellipse, label="id_detalle_producto"];
    dpp_cantidad [shape=ellipse, label="cantidad"];
    dpp_precio [shape=ellipse, label="precio_unitario"];

    DetalleVentaProducto -> dpp_id;
    DetalleVentaProducto -> dpp_cantidad;
    DetalleVentaProducto -> dpp_precio;

    // ATRIBUTOS DETALLE VENTA SERVICIO
    dps_id [shape=ellipse, label="id_detalle_servicio"];
    dps_cantidad [shape=ellipse, label="cantidad"];
    dps_precio [shape=ellipse, label="precio_unitario"];

    DetalleVentaServicio -> dps_id;
    DetalleVentaServicio -> dps_cantidad;
    DetalleVentaServicio -> dps_precio;

    // ATRIBUTOS RESERVA
    r_id [shape=ellipse, label="id_reserva"];
    r_fecha [shape=ellipse, label="fecha"];
    r_hora [shape=ellipse, label="hora"];
    r_estado [shape=ellipse, label="estado"];

    Reserva -> r_id;
    Reserva -> r_fecha;
    Reserva -> r_hora;
    Reserva -> r_estado;

    // RELACIONES PRINCIPALES

    Cliente -> Realiza [label="1"];
    Realiza -> Venta [label="N"];

    Empleado -> AtiendeVenta [label="1"];
    AtiendeVenta -> Venta [label="N"];

    Venta -> IncluyeProducto [label="1"];
    IncluyeProducto -> DetalleVentaProducto [label="N"];

    Producto -> IncluyeProducto [label="1"];

    Venta -> IncluyeServicio [label="1"];
    IncluyeServicio -> DetalleVentaServicio [label="N"];

    Servicio -> IncluyeServicio [label="1"];

    Producto -> Pertenece [label="N"];
    Pertenece -> Categoria [label="1"];

    Producto -> Suministra [label="N"];
    Suministra -> Proveedor [label="1"];

    Cliente -> Agenda [label="1"];
    Agenda -> Reserva [label="N"];

    Empleado -> AtiendeReserva [label="1"];
    AtiendeReserva -> Reserva [label="N"];

    Servicio -> ReservadoEn [label="1"];
    ReservadoEn -> Reserva [label="N"];

    Reserva -> Genera [label="0..1"];
    Genera -> Venta [label="1"];
}