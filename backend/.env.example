# PostgreSQL connection (for Docker Compose)
DB_HOST=db
DB_PORT=5432
DB_USER=proy2
DB_PASSWORD=secret
DB_NAME=barberdb

# Or for local development:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_NAME=yourdb

# JWT Secret Key (change this in production!)
JWT_SECRET=your-secret-key-here-min-32-chars
