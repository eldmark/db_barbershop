# PostgreSQL connection (for Docker Compose)
DB_HOST=db
DB_PORT=5432
DB_USER=proy3
DB_PASSWORD=secret
DB_NAME=barbershop
DATABASE_URL=postgresql://proy3:secret@db:5432/barbershop

# Or for local development:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=proy3
# DB_PASSWORD=secret
# DB_NAME=barbershop

# Session cookie configuration
SESSION_SECRET=super_secret_session
