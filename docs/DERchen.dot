digraph BarberiaER {
    rankdir=LR;
    node [fontname="Helvetica"];

    // ENTIDADES
    User [shape=box];
    Role [shape=box];
    Permission [shape=box];
    Employee [shape=box];
    Category [shape=box];
    Supplier [shape=box];
    Service [shape=box];
    Product [shape=box];
    Reservation [shape=box];
    Sale [shape=box];
    SaleDetailProduct [shape=box];
    SaleDetailService [shape=box];

    // RELACIONES
    HasRole [shape=diamond, label="has_role"];
    HasPermission [shape=diamond, label="has_permission"];
    Performs [shape=diamond, label="performs"];
    Schedules [shape=diamond, label="schedules"];
    AttendsSale [shape=diamond, label="attends"];
    AttendsReservation [shape=diamond, label="attends"];
    IncludesProduct [shape=diamond, label="includes"];
    IncludesService [shape=diamond, label="includes"];
    Classifies [shape=diamond, label="classifies"];
    Supplies [shape=diamond, label="supplies"];
    Books [shape=diamond, label="books"];
    Generates [shape=diamond, label="generates"];

    // ATRIBUTOS USER
    u_id [shape=ellipse, label="id_user"];
    u_name [shape=ellipse, label="name"];
    u_email [shape=ellipse, label="email"];
    u_password [shape=ellipse, label="password"];
    u_created [shape=ellipse, label="created_at"];
    u_updated [shape=ellipse, label="updated_at"];
    u_deleted [shape=ellipse, label="deleted_at"];

    User -> u_id;
    User -> u_name;
    User -> u_email;
    User -> u_password;
    User -> u_created;
    User -> u_updated;
    User -> u_deleted;

    // ATRIBUTOS ROLE
    r_id [shape=ellipse, label="id_role"];
    r_name [shape=ellipse, label="name"];

    Role -> r_id;
    Role -> r_name;

    // ATRIBUTOS PERMISSION
    p_id [shape=ellipse, label="id_permission"];
    p_name [shape=ellipse, label="name"];

    Permission -> p_id;
    Permission -> p_name;

    // RELACIONES RBAC
    User -> HasRole [label="N"];
    HasRole -> Role [label="N"];

    Role -> HasPermission [label="N"];
    HasPermission -> Permission [label="N"];

    // RELACIONES PRINCIPALES
    User -> Performs [label="1"];
    Performs -> Sale [label="N"];

    User -> Schedules [label="1"];
    Schedules -> Reservation [label="N"];

    Employee -> AttendsSale [label="1"];
    AttendsSale -> Sale [label="N"];

    Employee -> AttendsReservation [label="1"];
    AttendsReservation -> Reservation [label="N"];

    Product -> Classifies [label="N"];
    Classifies -> Category [label="1"];

    Product -> Supplies [label="N"];
    Supplies -> Supplier [label="1"];

    Sale -> IncludesProduct [label="1"];
    IncludesProduct -> SaleDetailProduct [label="N"];

    Product -> IncludesProduct [label="1"];

    Sale -> IncludesService [label="1"];
    IncludesService -> SaleDetailService [label="N"];

    Service -> IncludesService [label="1"];

    Service -> Books [label="1"];
    Books -> Reservation [label="N"];

    Reservation -> Generates [label="0..1"];
    Generates -> Sale [label="1"];
}